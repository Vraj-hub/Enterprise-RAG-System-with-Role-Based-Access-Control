# Copy this file to .env, then replace JWT_SECRET with a long random value.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=60

# Recommended local setup: Ollama semantic embeddings + local Ollama LLM
EMBEDDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_MODEL=qwen2.5:7b

# A fresh data folder prevents mixing old hash/ST vectors with Nomic vectors.
DATA_DIR=./data_nomic
